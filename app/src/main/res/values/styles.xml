<resources>
 <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:colorAccent">#147D70</item>
  <item name="android:windowBackground">#F4F7F8</item><item name="android:windowLightStatusBar">true</item><item name="android:windowLightNavigationBar">true</item>
  <item name="android:textColorPrimary">#172E3C</item><item name="android:textColorSecondary">#526773</item>
  <item name="android:buttonStyle">@style/AppButton</item><item name="android:windowActionModeOverlay">true</item>
 </style>
 <style name="AppButton" parent="android:style/Widget.Material.Button">
  <item name="android:minHeight">52dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">17sp</item>
 </style>
</resources>
